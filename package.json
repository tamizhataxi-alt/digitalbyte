{
  "name": "digitalbyte",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build:static": "node scripts/prepare-server-public.mjs",
    "build": "npm run install:all && npm run build:client && npm run build:static && npm run build:server",
    "build:hostinger": "npm install --omit=dev --prefix server",
    "start": "node server/dist/index.js",
    "package:hostinger": "node scripts/package-hostinger.mjs"
  }
}
